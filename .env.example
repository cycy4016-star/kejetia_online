# ── Kejetia Online — environment variables ─────────────────────────────
# Copy to `frontend/.env.local` for local development and set the same
# values (minus VERCEL_OIDC_TOKEN) as environment variables on Render.
#
# Local mock mode: leave NEXT_PUBLIC_SUPABASE_URL as the placeholder value
# and the app runs fully offline against localStorage.

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# Public anon key from Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Maps (optional) ─────────────────────────────────────────────────────
# The app renders on free CARTO/OSRM layers without a key. Add a Google
# Maps key only if you later switch the map tiles to Google.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Backend (Render sets PORT automatically) ────────────────────────────
PORT=5000
